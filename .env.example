# Meta Model API (https://dev.meta.ai). Without a key the crew runs in clearly labelled "Scripted crew" mode.
MODEL_API_KEY=
# Optional overrides. For Muse Spark Open on Baseten: MODEL_BASE_URL=https://inference.baseten.co/v1 MODEL_NAME=meta-models/muse-spark-open-1026
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3
MODEL_REASONING=low
# Set to "scripted" to force the deterministic crew even when a key is present.
CREW_PROVIDER=

# Spoken orders use Muse Voice Transcribe with the same key. Override only if Meta renames the model.
# ASR_MODEL=muse-voice-transcribe-1.0

# Overall crew/photo workflow deadline; capped at 50000 ms to finish before the 60 s function limit.
# Lower values are useful for failure testing. This never extends the hosting timeout.
# MODEL_REQUEST_BUDGET_MS=50000

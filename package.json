{
  "name": "crisiscraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @crisiscraft/web",
    "build": "npm run typecheck && npm run build --workspace @crisiscraft/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs",
    "assets:fetch": "python3 scripts/fetch-assets.py",
    "meta:check": "node --env-file-if-exists=.env scripts/meta-check.mjs",
    "eval:crew": "esbuild scripts/eval-crew.ts --bundle --platform=node --format=esm --target=node22 --outfile=.data/eval-crew.mjs --log-level=warning && node --env-file-if-exists=.env .data/eval-crew.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react-test-renderer": "^19.3.0",
    "esbuild": "^0.28.2",
    "react-test-renderer": "^19.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
